{
  "name": "crm-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "clock-client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:crm": "npm run dev --workspace=client -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server:fixed": "cross-env PORT=4000 npm run dev --workspace=server",
    "dev:timeclock": "npm run dev --workspace=clock-client",
    "dev:all": "concurrently -n crm,api,timeclock -c green,blue,magenta \"npm run dev:crm\" \"npm run dev:server:fixed\" \"npm run dev:timeclock\"",
    "start:local": "node scripts/start-local.mjs",
    "stop:local": "node scripts/stop-local.mjs",
    "build:release": "node scripts/build-release.mjs",
    "start:prod": "node scripts/start-production.mjs",
    "preflight:prod": "node scripts/production-preflight.mjs",
    "check:prod": "cross-env NODE_ENV=production JOINERFLOW_CONFIG_CHECK_ONLY=true npm run start --workspace=server",
    "dev:test:server": "cross-env NODE_ENV=test ENABLE_TEST_AUTH=true AUTH_SESSION_SECRET=joinerflow-test-session-secret PORT=4100 SQLITE_PATH=server/.joinerflow-runtime/e2e.sqlite FILESYSTEM_ROOT=server/.joinerflow-runtime/e2e-filesystem LOG_DIRECTORY=server/.joinerflow-runtime/e2e-logs npm run dev --workspace=server",
    "dev:test:client": "cross-env VITE_ENABLE_TEST_AUTH=true VITE_DEV_PROXY_TARGET=http://127.0.0.1:4100 npm run dev --workspace=client -- --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:timeclock": "npm run build --workspace=clock-client",
    "smoke": "npm run smoke --workspace=server",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:headed": "playwright test --config=playwright.visual.config.ts --headed",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "install-all": "npm install"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <27"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
