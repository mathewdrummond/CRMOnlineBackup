{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "staff_name": {
      "type": "string",
      "title": "Staff Name"
    },
    "staff_email": {
      "type": "string",
      "title": "Staff Email"
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "job_number": {
      "type": "string",
      "title": "Job Number"
    },
    "job_title": {
      "type": "string",
      "title": "Job Title"
    },
    "operation": {
      "type": "string",
      "title": "Operation",
      "enum": [
        "design",
        "ordering",
        "cnc",
        "machining",
        "edging",
        "assembly",
        "finishing",
        "delivery",
        "install",
        "break",
        "other"
      ]
    },
    "clock_in": {
      "type": "string",
      "title": "Clock In",
      "format": "date-time"
    },
    "clock_out": {
      "type": "string",
      "title": "Clock Out",
      "format": "date-time"
    },
    "hours": {
      "type": "number",
      "title": "Hours",
      "default": 0
    },
    "hourly_rate": {
      "type": "number",
      "title": "Hourly Rate",
      "default": 0
    },
    "total_cost": {
      "type": "number",
      "title": "Total Cost",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "completed",
        "approved",
        "rejected"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_break": {
      "type": "boolean",
      "title": "Is Break",
      "default": false
    },
    "date": {
      "type": "string",
      "title": "Date",
      "format": "date"
    }
  },
  "required": [
    "staff_email"
  ]
}