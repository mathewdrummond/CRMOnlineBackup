{
  "name": "AppAlert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "info",
        "warning",
        "urgent",
        "overdue"
      ],
      "default": "info"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "lead",
        "quote",
        "job",
        "purchasing",
        "timesheet",
        "general"
      ],
      "default": "general"
    },
    "related_id": {
      "type": "string",
      "title": "Related Record ID"
    },
    "related_type": {
      "type": "string",
      "title": "Related Type"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To"
    },
    "is_read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    },
    "is_resolved": {
      "type": "boolean",
      "title": "Resolved",
      "default": false
    }
  },
  "required": [
    "title",
    "message"
  ]
}