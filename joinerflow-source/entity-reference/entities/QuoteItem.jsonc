{
  "name": "QuoteItem",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "title": "Quote ID"
    },
    "section": {
      "type": "string",
      "title": "Section",
      "default": "General"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "labour",
        "materials",
        "hardware",
        "subcontract",
        "delivery",
        "install",
        "other"
      ],
      "default": "materials"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity",
      "default": 1
    },
    "unit": {
      "type": "string",
      "title": "Unit",
      "default": "ea"
    },
    "unit_cost": {
      "type": "number",
      "title": "Unit Cost",
      "default": 0
    },
    "markup_percent": {
      "type": "number",
      "title": "Markup %",
      "default": 30
    },
    "sell_price": {
      "type": "number",
      "title": "Sell Price",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Line Total",
      "default": 0
    },
    "is_optional": {
      "type": "boolean",
      "title": "Optional Item",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "quote_id",
    "description"
  ]
}