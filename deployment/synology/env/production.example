NODE_ENV=production
HOST=0.0.0.0
PORT=4000
DATABASE_DRIVER=sqlite
DATABASE_SHADOW_WRITE=true
DATABASE_URL=postgresql://joinerflow:replace-with-password@postgres:5432/joinerflow
PGHOST=postgres
PGPORT=5432
JOINERFLOW_POSTGRES_PORT=15432
PGDATABASE=joinerflow
PGUSER=joinerflow
PGPASSWORD=replace-with-password
PGPOOL_MAX=8
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000

PUBLIC_API_ORIGIN=https://crm.example.com
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
AUTH_SESSION_SECRET=replace-with-strong-32-plus-character-secret
AUTH_BOOTSTRAP_ADMIN_EMAILS=owner@example.com

ALLOWED_HOSTS=crm.example.com,timeclock.example.com
CORS_ORIGIN=https://crm.example.com,https://timeclock.example.com
TRUST_PROXY=true
AUTH_SECURE_COOKIE=true
AUTH_SESSION_TTL_HOURS=12
TIMECLOCK_KIOSK_KEY=replace-with-strong-random-key

SQLITE_PATH=/volume1/joinerflow/server/joinerflow.sqlite
FILESYSTEM_ROOT=/volume1/joinerflow/filesystem
BACKUP_ROOT=/volume1/joinerflow/backups
LOG_DIRECTORY=/volume1/joinerflow/logs
JOINERFLOW_ARCHIVE_ROOT=/volume1/archive

MAX_REQUEST_BODY_SIZE_MB=100
DIAGNOSTICS_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=60
AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_ENTITIES=entity_embeddings
QDRANT_COLLECTION_KNOWLEDGE=knowledge_chunks
QDRANT_REQUEST_TIMEOUT_MS=3000
AI_REQUEST_TIMEOUT_MS=45000
AI_REQUEST_RETRIES=1
AI_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MS=60000
AI_KNOWLEDGE_MAX_CONCURRENT=1
AI_VECTOR_QUEUE_MAX=5000
AI_EMBED_QUEUE_MAX=5000
AI_EMBED_QUEUE_DELAY_MS=800
AI_KNOWLEDGE_QUEUE_MAX=15000
AI_KNOWLEDGE_ALLOWED_ROOTS=/volume1/joinerflow/filesystem,/volume1/joinerflow/imports,/volume1/archive
JOINERFLOW_ENABLE_OPEN_WEBUI=false
VITE_TIMECLOCK_URL=https://timeclock.example.com
