# Leave blank for same-origin reverse-proxy hosting.
VITE_API_BASE_URL=
# Optional: direct URL for the standalone time clock screen.
# In production, set this explicitly if the CRM login page should link to it.
VITE_TIMECLOCK_URL=
# Test-only auth bypass for local/dev test runs. Keep false in production.
VITE_ENABLE_TEST_AUTH=false
# Optional: override the test-auth API when client and API dev servers run on different ports.
VITE_TEST_AUTH_API_BASE_URL=
