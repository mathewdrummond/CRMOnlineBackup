{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "tsc && node dist/smoke.js",
    "test": "cd .. && vitest run server/src --project node",
    "db:migrate": "npm run build && node dist/dbMigrationCli.js migrate",
    "db:status": "npm run build && node dist/dbMigrationCli.js status",
    "db:verify": "npm run build && node dist/dbMigrationCli.js verify"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "pg": "^8.16.3",
    "playwright-core": "^1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
