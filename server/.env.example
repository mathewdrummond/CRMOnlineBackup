PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Required for CRM Google sign-in. Use the current GOOGLE_CLIENT_ID as the
# production credential too; do not create a second dev/prod split here.
# This app uses the Google Identity Services browser credential flow, so
# configure the exact production CRM origin (for example
# https://crm.example.com with no path) as an Authorized JavaScript origin in
# Google Cloud. No GOOGLE_CLIENT_SECRET or OAuth redirect URI is used by this
# login flow.
GOOGLE_CLIENT_ID=
# Required until at least one AppUser has been invited through the CRM.
AUTH_BOOTSTRAP_ADMIN_EMAILS=
# Required for signed login sessions in every non-test environment.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=12
# Set true in production so session cookies are always marked secure.
AUTH_SECURE_COOKIE=false
TRUST_PROXY=false
CORS_ORIGIN=
ALLOWED_HOSTS=
# Required in production and must be the public HTTPS CRM origin only.
# Do not include a path, query string, or hash.
PUBLIC_API_ORIGIN=
TIMECLOCK_KIOSK_KEY=
# Required explicitly in production so the live install does not silently fall
# back to old local runtime data paths.
SQLITE_PATH=./data/joinerflow.sqlite
FILESYSTEM_ROOT=./filesystem
