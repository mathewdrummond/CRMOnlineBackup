{
  "name": "Note",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "title": "Content"
    },
    "related_id": {
      "type": "string",
      "title": "Related Record ID"
    },
    "related_type": {
      "type": "string",
      "title": "Related Type",
      "enum": [
        "lead",
        "quote",
        "job",
        "contact",
        "company",
        "purchase_order"
      ]
    },
    "type": {
      "type": "string",
      "title": "Note Type",
      "enum": [
        "note",
        "call_log",
        "email",
        "meeting",
        "site_visit"
      ],
      "default": "note"
    },
    "author_name": {
      "type": "string",
      "title": "Author"
    }
  },
  "required": [
    "content",
    "related_id",
    "related_type"
  ]
}