{
  "name": "Contact",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "company_id": {
      "type": "string",
      "title": "Company ID"
    },
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "client",
        "builder",
        "designer",
        "architect",
        "supplier",
        "subcontractor"
      ],
      "default": "client"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "mobile": {
      "type": "string",
      "title": "Mobile"
    },
    "position": {
      "type": "string",
      "title": "Position/Title"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "postcode": {
      "type": "string",
      "title": "Postcode"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}