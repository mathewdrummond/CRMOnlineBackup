{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "title": "PO Number"
    },
    "supplier_id": {
      "type": "string",
      "title": "Supplier ID"
    },
    "supplier_name": {
      "type": "string",
      "title": "Supplier Name"
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "job_number": {
      "type": "string",
      "title": "Job Number"
    },
    "job_title": {
      "type": "string",
      "title": "Job Title"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "sent",
        "acknowledged",
        "part_received",
        "received",
        "cancelled"
      ],
      "default": "draft"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "gst": {
      "type": "number",
      "title": "GST",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "order_date": {
      "type": "string",
      "title": "Order Date",
      "format": "date"
    },
    "expected_date": {
      "type": "string",
      "title": "Expected Delivery",
      "format": "date"
    },
    "received_date": {
      "type": "string",
      "title": "Received Date",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "ordered_by": {
      "type": "string",
      "title": "Ordered By"
    }
  },
  "required": [
    "supplier_name"
  ]
}