{
  "name": "POItem",
  "type": "object",
  "properties": {
    "po_id": {
      "type": "string",
      "title": "PO ID"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity",
      "default": 1
    },
    "unit": {
      "type": "string",
      "title": "Unit",
      "default": "ea"
    },
    "unit_price": {
      "type": "number",
      "title": "Unit Price",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Line Total",
      "default": 0
    },
    "received_qty": {
      "type": "number",
      "title": "Received Qty",
      "default": 0
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "po_id",
    "description"
  ]
}