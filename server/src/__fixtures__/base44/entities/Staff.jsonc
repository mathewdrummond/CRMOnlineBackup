{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID (MYOB)"
    },
    "email": {
      "type": "string",
      "title": "Email Address"
    },
    "hourly_rate": {
      "type": "number",
      "title": "Hourly Rate"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "employee_id"
  ]
}