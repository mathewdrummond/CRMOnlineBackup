{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "job_number": {
      "type": "string",
      "title": "Job Number"
    },
    "job_title": {
      "type": "string",
      "title": "Job Title"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "deposit",
        "progress",
        "final",
        "variation"
      ],
      "default": "final"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "gst": {
      "type": "number",
      "title": "GST",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid",
      "default": 0
    },
    "issue_date": {
      "type": "string",
      "title": "Issue Date",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "title": "Due Date",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "title": "Paid Date",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "job_id"
  ]
}