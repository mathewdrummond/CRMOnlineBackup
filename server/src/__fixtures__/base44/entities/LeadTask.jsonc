{
  "name": "LeadTask",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "title": {
      "type": "string",
      "title": "Task Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "due_date": {
      "type": "string",
      "title": "Due Date",
      "format": "date"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "type": {
      "type": "string",
      "title": "Task Type",
      "enum": [
        "follow_up",
        "call",
        "email",
        "site_visit",
        "measure",
        "design",
        "other"
      ],
      "default": "follow_up"
    }
  },
  "required": [
    "lead_id",
    "title"
  ]
}